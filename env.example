# Application Environment Configuration Example
PROJECT_NAME="StreamForge - Distributed Python Event Processor"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=True

# Database Configuration (PostgreSQL with asyncpg driver)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=streamforge_user
POSTGRES_PASSWORD=streamforge_secret
POSTGRES_DB=streamforge_db

# Asynchronous Database URL format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://streamforge_user:streamforge_secret@localhost:5432/streamforge_db

# JWT Security Configuration
# Generate secret key using: openssl rand -hex 32
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Apache Kafka Broker Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SENSOR_TOPIC=sensor_events
KAFKA_ALERT_TOPIC=sensor_alerts
KAFKA_CONSUMER_GROUP=streamforge_processor_group
